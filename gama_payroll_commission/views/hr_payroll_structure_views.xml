<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_structure_form_gama_commission" model="ir.ui.view">
        <field name="name">hr.payroll.structure.form.gama.commission</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_employee_grade_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="gama_commission" string="Comisiones de ventas">
                    <group>
                        <field name="gama_commission"/>
                        <field name="gama_cash_term_ids" widget="many2many_tags" invisible="not gama_commission"/>
                        <field name="gama_base" invisible="not gama_commission"/>
                        <field name="gama_use_route" invisible="not gama_commission"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
